<resources>
    <!-- System splash (Android 12+ and compat): plain white, no icon, so it blends into the full splash image in MainActivity -->
    <style name="Theme.ZXTape.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.ZXTape</item>
    </style>

    <style name="Theme.ZXTape" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
